# Build output
/bin/
/data/
# build.sh 的产物（Go 缓存在仓库外，见 build.sh 注释）
/outputs/
# A stray root-level binary, if anyone builds with `go build ./cmd/eventd`.
# Anchored on purpose: an unanchored "eventd" would also ignore cmd/eventd/.
/eventd

# SQLite runtime files
*.db
*.db-shm
*.db-wal

# Editor / OS noise
.DS_Store
.idea/
.vscode/
*.swp
